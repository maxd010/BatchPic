{
  // 应用唯一标识符 (反向域名格式)
  appId: "com.batchpic.app",
  
  // 应用显示名称
  productName: "BatchPic",
  
  // 版权信息
  copyright: "Copyright © 2024 BatchPic",
  
  // 目录配置
  directories: {
    // 构建产物输出目录
    output: "release",
    // 构建资源目录 (图标、背景图等)
    buildResources: "build"
  },
  
  // 需要打包的文件和目录
  files: [
    "dist/**/*",
    "package.json"
  ],
  
  // 排除不需要打包的文件
  extraMetadata: {
    main: "dist/main/main.js"
  },
  
  // macOS 平台配置
  mac: {
    // 目标格式: DMG 镜像和 ZIP 压缩包
    target: ["dmg", "zip"],
    // 应用图标路径
    icon: "build/icons/icon.icns",
    // 应用分类 (在 macOS 应用商店中的分类)
    category: "public.app-category.graphics-design",
    // 强化运行时 (macOS 10.14+ 安全要求)
    hardenedRuntime: true,
    // Gatekeeper 评估 (允许未签名应用运行)
    gatekeeperAssess: false,
    // DMG 窗口配置
    dmg: {
      // DMG 窗口大小
      window: {
        width: 540,
        height: 380
      },
      // DMG 内容布局
      contents: [
        {
          x: 140,
          y: 180,
          type: "file"
        },
        {
          x: 400,
          y: 180,
          type: "link",
          path: "/Applications"
        }
      ]
    }
  },
  
  // Windows 平台配置
  win: {
    // 目标格式: NSIS 安装器和便携版
    target: [
      {
        target: "nsis",
        arch: ["x64"]
      },
      {
        target: "portable",
        arch: ["x64"]
      }
    ],
    // 应用图标路径
    icon: "build/icons/icon.ico",
    // 产物命名模式
    artifactName: "${productName}-${version}-${os}-${arch}.${ext}",
    // NSIS 安装器配置
    nsis: {
      // 一键安装 (false 表示显示安装向导)
      oneClick: false,
      // 为所有用户安装 (需要管理员权限)
      perMachine: false,
      // 允许用户选择安装目录
      allowToChangeInstallationDirectory: true,
      // 创建桌面快捷方式
      createDesktopShortcut: true,
      // 创建开始菜单快捷方式
      createStartMenuShortcut: true
    }
  }
}
